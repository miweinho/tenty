<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>backend_tenty</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    
        
  

    <ItemGroup>
        <Compile Include="Service\GeoJsonService.fs" />
        <Compile Include="Model/Model.fs" />
        <Compile Include="Service\ResultExt.fs" />
        <Compile Include="Model\Errors.fs" />
        <Compile Include="Model\Validation\ValidateDbData.fs" />
        <Compile Include="Model\Validation\ValidateClientData.fs" />
        <Compile Include="Model\Conversion\DBConversions.fs" />
        <Compile Include="Model\Conversion\DTOConversion.fs" />
        <Compile Include="Database\Database.fs" />
        <Compile Include="Model\UserService.fs" />
        <Compile Include="Model\AuthService.fs" />
        <Compile Include="Model\CampService.fs" />
        <Compile Include="Model\FeatureService.fs" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Include="Dockerfile" />
      <Compile Include="Controller\CampController.fs" />
      <Compile Include="Controller\UserController.fs" />
      <Compile Include="Controller\FeatureController.fs" />
      <Compile Include="Program.fs" />
      
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FsToolkit.ErrorHandling" Version="5.1.0" />
      <PackageReference Include="Giraffe" Version="8.1.0-alpha-001" />
      <PackageReference Include="Giraffe.OpenApi" Version="0.0.2" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.10" />
      <PackageReference Include="NetTopologySuite" Version="2.6.0" />
      <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="8.0.5" />
        <PackageReference Include="Npgsql.FSharp" Version="5.7.0" />
    </ItemGroup>

</Project>
